private theorem affine_cap (K : Finset ℕ) (b r m : ℕ) (hr : 0 < r) (cop : r.Coprime 30030)
    (cap : ∀ u < r, (K.filter (fun k => k % r=u)).card ≤ m) (t : ℕ) :
    ((K.image (fun k => b+30030*k)).filter (fun p => p % r=t)).card ≤ m := by
  let f (k : ℕ) := b+30030*k
  let G := (K.image f).filter (fun p => p % r=t)
  change G.card ≤ m
  by_cases hn : G.Nonempty
  · obtain ⟨v,hv⟩ := hn
    obtain ⟨hmem,hres⟩ := Finset.mem_filter.mp hv
    obtain ⟨k0,_,rfl⟩ := Finset.mem_image.mp hmem
    have sub : G ⊆ (K.filter (fun k => k % r=k0 % r)).image f := by
      intro p hp
      obtain ⟨hm,ht⟩ := Finset.mem_filter.mp hp
      obtain ⟨k,hk,rfl⟩ := Finset.mem_image.mp hm
      have eq : b+30030*k ≡ b+30030*k0 [MOD r] := ht.trans hres.symm
      have eq' := Nat.ModEq.add_left_cancel (Nat.ModEq.refl b) eq
      have eqk := Nat.ModEq.cancel_left_of_coprime cop eq'
      exact Finset.mem_image.mpr ⟨k,Finset.mem_filter.mpr ⟨hk,eqk⟩,rfl⟩
    exact (Finset.card_le_card sub).trans (Finset.card_image_le.trans (cap _ (Nat.mod_lt _ hr)))
  · simp [Finset.not_nonempty_iff_eq_empty.mp hn]

