theorem of_block {b hi code : ℕ} (hb : b < 30030)
    (block : WheelAnchorBlock.Block b 0 hi 8192 code) (limits : List ℕ)
    (hbudget : (∑ q∈extra, limits.getD q 0) ≤ 8087)
    (hcheck : ∀ q∈extra, tableCheck code limits q=true) : Row b := by
  obtain ⟨K,hcard,hpr,hs⟩ := block
  have heq : (∑ k∈K, 32768^k) = code := by simpa using hs
  let f (k : ℕ) := b+30030*k
  have inj : Function.Injective f := by intro i j h; dsimp [f] at h; omega
  refine ⟨K.image f,(Finset.card_image_of_injective _ inj).trans hcard,?_,(fun r => limits.getD r 0),hbudget,?_⟩
  · intro p hp
    obtain ⟨k,hk,rfl⟩ := Finset.mem_image.mp hp
    exact ⟨(hpr k hk).2.2.1,(hpr k hk).2.2.2,by dsimp [f]; omega⟩
  · intro r hr t _
    obtain ⟨hmin,hprime⟩ := (Finset.mem_filter.mp hr).2
    have hpos := hprime.pos
    have hcop : ∀ q∈extra, Nat.Coprime q 30030 := by decide +kernel
    refine affine_cap K b r (limits.getD r 0) hpos (hcop r hr) ?_ t
    intro u hu
    have hv := hcheck r hr
    simp [tableCheck,hmin,hprime] at hv
    have hj := within_sound hv u hu
    rw [← Conjectures.Goldbach.WheelCyclicHistogram K 32768 r u (by omega) hpos,heq]
    exact hj

