theorem cover (q : ℕ) (h : 2≤q) (hu : q≤44000) : q∣common := by
  let i := (q-1)/256
  let j := (q-1) % 256
  have hi : i<172 := by dsimp [i]; omega
  have hj : j<256 := Nat.mod_lt _ (by decide)
  have eq : 1+256*i+j=q := by dsimp [i,j]; omega
