def Row (b : ℕ) : Prop :=
  ∃ S : Finset ℕ, S.card=8192 ∧
    (∀ p∈S, p.Prime ∧ p ≤ 1076245223 ∧ p % 30030=b) ∧
    ∃ loss : ℕ → ℕ, (∑ r∈extra, loss r) ≤ 8087 ∧
      ∀ r∈extra, ∀ t < r, (S.filter (fun p => p % r=t)).card ≤ loss r

