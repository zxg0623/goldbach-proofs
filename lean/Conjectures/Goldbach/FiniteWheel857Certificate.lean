theorem hundred_one (rows : ∀ b∈bases, Row b) (n : ℕ) (hn : 1076245225 ≤ n) (he : Even n) :
    ∃ S : Finset ℕ, 105 ≤ S.card ∧ ∀ p∈S, p.Prime ∧ p ≤ 1076245223 ∧ 2 ≤ n-p ∧
      (∀ q : ℕ, q.Prime → q ∣ n-p → 857 ≤ q) := by
  obtain ⟨k,hk⟩ := he
  have he' : Even (n % 30030) := ⟨(n % 30030)/2,by omega⟩
  obtain ⟨b,hb,_,hc⟩ := PEqualNP.Outside.L_goldbach_finite_wheel_unit_base
    _ (Nat.mod_lt _ (by decide)) he'
  have hb' : b ∈ bases := hb
  have blt := (by decide : ∀ b∈bases, b < 30030) b hb'
  have modfix : (n % 30030+30030-b) % 30030 = (n+30030-b) % 30030 := by omega
  rw [modfix] at hc
  obtain ⟨S,hcard,hanchors,loss,hloss,hcap⟩ := rows b hb'
  have count := FiniteWheelMultiplicity.coprime_count extra S b 30030 1076245223 n loss blt hn hc
    hanchors (fun q hq => (Finset.mem_filter.mp hq).2.2) hcap
  refine ⟨S.filter (fun p => p.Prime ∧ p ≤ 1076245223 ∧ 2 ≤ n-p ∧
    (n-p).Coprime (30030*∏ r∈extra, r)),by omega,?_⟩
  intro p hp
  obtain ⟨_,hprime,hB,h2,hcop⟩ := Finset.mem_filter.mp hp
  refine ⟨hprime,hB,h2,?_⟩
  intro q hq hd
  by_contra! hu
  have hw : q ∣ 30030*∏ r∈extra, r := by
    by_cases hs : q < 17
    · have small : ∀ r : Fin 17, r.val.Prime → r.val ∣ 30030 := by decide
      exact dvd_mul_of_dvd_left (small ⟨q,hs⟩ hq) _
    · have hm : q∈extra := Finset.mem_filter.mpr ⟨Finset.mem_range.mpr hu,by omega,hq⟩
      exact dvd_mul_of_dvd_right (Finset.dvd_prod_of_mem id hm) _
  exact hq.ne_one (Nat.eq_one_of_dvd_coprimes hcop hd hw)

end WheelFiberCertificate

/- A single high bit in each base-32768 digit checks all fiber caps at once.
   The bound of 16384 on every count makes subtraction within each digit exact. -/
namespace WheelPackedCaps

private def rep : ℕ → ℕ
  | 0 => 0
  | q+1 => 1+32768*rep q

private theorem rep_product (q : ℕ) : 32767*rep q+1=32768^q := by
  induction q with
  | zero => rfl
  | succ q ih =>
    rw [rep,pow_succ,← ih]
    ring

def units (q : ℕ) : ℕ := ((1 <<< (15*q))-1)/32767

private theorem units_eq (q : ℕ) : units q=rep q := by
  unfold units
  rw [Nat.shiftLeft_eq,one_mul,Nat.pow_mul,show 2^15=32768 by decide,← rep_product]
  simp

def check (q x cap : ℕ) : Bool :=
  let ones := units q
  let top := 16384*ones
  (((16384+cap)*ones-x) &&& top) == top

private theorem digit_succ (x i : ℕ) :
    x/32768^(i+1) % 32768 = (x/32768)/32768^i % 32768 := by
  rw [Nat.div_div_eq_div_mul,pow_succ']

private theorem tail_lt {q x : ℕ} (h : x<32768^(q+1)) : x/32768<32768^q :=
  (Nat.div_lt_iff_lt_mul (by decide : 0<32768)).mpr (by simpa [pow_succ] using h)

private theorem room (q x : ℕ) (size : x<32768^q)
    (bounded : ∀ i<q, x/32768^i % 32768 ≤ 16384) : x ≤ 16384*rep q := by
  induction q generalizing x with
  | zero => simp [rep] at size ⊢; omega
  | succ q ih =>
    have low : x % 32768 ≤ 16384 := by simpa using bounded 0 (Nat.zero_lt_succ q)
    have high := ih (x/32768) (tail_lt size)
      (fun i hi => (digit_succ x i).symm ▸ bounded (i+1) (Nat.succ_lt_succ hi))
    have split := Nat.mod_add_div x 32768
    rw [rep]
    omega

private theorem lowAnd (a b : ℕ) :
    (a &&& b) % 32768 = (a % 32768) &&& (b % 32768) :=
  Nat.and_mod_two_pow (n:=15)

private theorem highAnd (a b : ℕ) :
    (a &&& b)/32768 = (a/32768) &&& (b/32768) :=
  Nat.and_div_two_pow (n:=15)

private theorem charge_succ (c q : ℕ) : c*rep (q+1)=c+32768*(c*rep q) := by
  rw [rep]
  ring

private theorem sound_aux (q x cap : ℕ) (hc : cap<16384) (size : x<32768^q)
    (bounded : ∀ i<q, x/32768^i % 32768 ≤ 16384)
    (packed : (((16384+cap)*rep q-x) &&& (16384*rep q))=16384*rep q) :
    ∀ i<q, x/32768^i % 32768 ≤ cap := by
  induction q generalizing x with
  | zero => omega
  | succ q ih =>
    let d := x % 32768
    let y := x/32768
    have hd : d≤16384 := by simpa [d] using bounded 0 (Nat.zero_lt_succ q)
    have hy : y<32768^q := tail_lt size
    have hb : ∀ i<q, y/32768^i % 32768 ≤ 16384 := by
      intro i hi
      exact (digit_succ x i).symm ▸ bounded (i+1) (Nat.succ_lt_succ hi)
    have room' : y ≤ (16384+cap)*rep q :=
      (room q y hy hb).trans (Nat.mul_le_mul_right _ (by omega))
    have split : d+32768*y=x := Nat.mod_add_div _ _
    let tail := (16384+cap)*rep q-y
    let digit := 16384+cap-d
    have balance : (16384+cap)*rep (q+1)-x = digit+32768*tail := by
      have ht : tail+y=(16384+cap)*rep q := Nat.sub_add_cancel room'
      have hd' : digit+d=16384+cap := Nat.sub_add_cancel (by omega)
      rw [charge_succ]
      omega
    have digitLt : digit<32768 := by dsimp [digit]; omega
    rw [balance,charge_succ] at packed
    have low := congrArg (fun n : ℕ => n % 32768) packed
    rw [lowAnd, show (digit+32768*tail) % 32768=digit by omega,
        show (16384+32768*(16384*rep q)) % 32768=16384 by omega] at low
    have high := congrArg (fun n : ℕ => n/32768) packed
    rw [highAnd,show (digit+32768*tail)/32768=tail by omega,
        show (16384+32768*(16384*rep q))/32768=16384*rep q by omega] at high
    have highBit : 16384 ≤ digit := low ▸ (Nat.and_le_left (n:=digit) (m:=16384))
    intro i hi
    cases i with
    | zero =>
      simp only [pow_zero,Nat.div_one]
      change d≤cap
      dsimp [digit] at highBit
      omega
    | succ i =>
      rw [digit_succ]
      exact ih y hy hb high i (Nat.lt_of_succ_lt_succ hi)

theorem sound {q x cap : ℕ} (hc : cap<16384) (size : x<32768^q)
    (bounded : ∀ i<q, x/32768^i % 32768 ≤ 16384) (ok : check q x cap=true) :
    ∀ i<q, x/32768^i % 32768 ≤ cap := by
  unfold check at ok
  simp only [units_eq,beq_iff_eq] at ok
  exact sound_aux q x cap hc size bounded ok

end WheelPackedCaps

namespace WheelFastRow

def check (code : ℕ) (caps : List ℕ) (r : ℕ) : Bool :=
  if 17≤r ∧ r.Prime then
    let c := caps.getD r 0
    decide (c<16384) && WheelPackedCaps.check r (code % ((1 <<< (15*r))-1)) c
  else true

private theorem shift_base (r : ℕ) : (1 <<< (15*r)) = 32768^r := by
  rw [Nat.shiftLeft_eq,one_mul,Nat.pow_mul,show 2^15=32768 by decide]

private theorem within_of_digits (n x cap : ℕ) (h : ∀ t<n, (x/32768^t) % 32768≤cap) :
    WheelFiberCertificate.within n x cap=true := by
  induction n generalizing x with
  | zero => rfl
  | succ n ih =>
    apply Bool.and_eq_true_iff.mpr
    refine ⟨decide_eq_true (by simpa using h 0 (Nat.zero_lt_succ _)), ih (x/32768) ?_⟩
    intro t ht
    simpa [Nat.div_div_eq_div_mul,pow_succ'] using h (t+1) (Nat.succ_lt_succ ht)

theorem of_block {b hi code : ℕ} (hb : b<30030)
    (block : WheelAnchorBlock.Block b 0 hi 8192 code) (caps : List ℕ)
    (budget : (∑ r∈WheelFiberCertificate.extra, caps.getD r 0) ≤ 8087)
    (proofs : ∀ r∈WheelFiberCertificate.extra, check code caps r=true) :
    WheelFiberCertificate.Row b := by
  apply WheelFiberCertificate.of_block hb block caps budget
  obtain ⟨K,hCard,_,hcode⟩ := block
  have eq : (∑ k∈K, 32768^k) = code := by simpa using hcode
  intro r hr
  obtain ⟨hmin,hprime⟩ := (Finset.mem_filter.mp hr).2
  have packed := proofs r hr
  simp only [check,if_pos (And.intro hmin hprime),Bool.and_eq_true_iff,decide_eq_true_eq,
    shift_base] at packed
  unfold WheelFiberCertificate.tableCheck
  rw [if_pos (And.intro hmin hprime)]
  apply within_of_digits
  apply WheelPackedCaps.sound packed.1 ?_ ?_ packed.2
  · have big : 1<32768^r := Nat.one_lt_pow (by omega) (by decide)
    exact (Nat.mod_lt _ (by omega)).trans_le (Nat.sub_le _ _)
  · intro t _
    rw [← eq,Conjectures.Goldbach.WheelCyclicHistogram K 32768 r t (by omega) hprime.pos]
    exact (Finset.card_filter_le K _).trans (by omega)

end WheelFastRow

namespace CompactWheel

structure Summary where
  count : ℕ
  code : ℕ
  valid : Bool

def span : ℕ → ℕ
  | 0 => 70
  | h+1 => span h + span h

def combine (shift : ℕ) (l r : Summary) : Summary :=
  ⟨l.count+r.count, l.code+(r.code <<< (15*shift)), l.valid && r.valid⟩

def summarize (b : ℕ) : (h lo mask : ℕ) → Summary
  | 0, lo, mask =>
    let s := WheelAnchorBlock.scan b lo mask 70
    ⟨s.count, s.code, s.valid && decide (s.product.gcd WheelFactorCover.common = 1)⟩
  | h+1, lo, mask =>
    let w := span h
    combine w (summarize b h lo (mask % (1 <<< w)))
              (summarize b h (lo+w) (mask >>> w))

theorem sound (b h lo mask : ℕ) (valid : (summarize b h lo mask).valid = true) :
    WheelAnchorBlock.Block b lo (lo+span h) (summarize b h lo mask).count
      (summarize b h lo mask).code := by
  induction h generalizing lo mask with
  | zero =>
    obtain ⟨v, cop⟩ := Bool.and_eq_true_iff.mp valid
    exact WheelAnchorBlock.scanned_coprime b lo mask 70 WheelFactorCover.common
      WheelFactorCover.cover v (of_decide_eq_true cop)
  | succ h ih =>
    let w := span h
    let l := summarize b h lo (mask % (1 <<< w))
    let r := summarize b h (lo+w) (mask >>> w)
    change (l.valid && r.valid) = true at valid
    obtain ⟨vl,vr⟩ := Bool.and_eq_true_iff.mp valid
    have L := ih lo (mask % (1 <<< w)) vl
    have R := ih (lo+w) (mask >>> w) vr
    have joined := WheelAnchorBlock.join (by omega : lo ≤ lo+w)
      (by omega : lo+w ≤ lo+w+w) L R
    change WheelAnchorBlock.Block b lo (lo+(w+w)) (l.count+r.count) (l.code+(r.code <<< (15*w)))
    rw [← Nat.add_assoc, Nat.shiftLeft_eq, Nat.pow_mul, show 2^15=32768 by decide, Nat.mul_comm r.code]
    simpa only [Nat.add_sub_cancel_left] using joined

/- The masks select the lowest bit of each block of consecutive binary digits.
   Each step separates the two halves of all occupied blocks simultaneously. -/
def spread (bits : ℕ) : ℕ → ℕ → ℕ
  | 0, x => x
  | h+1, x =>
    let stride := 1 <<< h
    let period := 15*stride
    let lanes := ((1 <<< (15*bits))-1) / ((1 <<< period)-1)
    let keep := lanes*((1 <<< stride)-1)
    spread bits h ((x ||| (x <<< (14*stride))) &&& keep)

end CompactWheel

