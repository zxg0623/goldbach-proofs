theorem within_sound {n x m : ℕ} (h : within n x m=true) :
    ∀ t < n, (x/32768^t) % 32768 ≤ m := by
  induction n generalizing x with
  | zero => omega
  | succ n ih =>
    obtain ⟨h0,hn⟩ := Bool.and_eq_true_iff.mp h
    intro t ht
    cases t with
    | zero => simpa using of_decide_eq_true h0
    | succ t =>
      have := ih hn t (Nat.lt_of_succ_lt_succ ht)
      simpa only [Nat.div_div_eq_div_mul, pow_succ'] using this

