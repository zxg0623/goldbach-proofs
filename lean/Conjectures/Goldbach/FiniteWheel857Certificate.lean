/-!
Certificates for a finite prime table in one residue class modulo 30030.
Blocks come with their exact generating polynomial and cardinality. Adjacent
blocks compose without testing a large finite set for duplicate entries.
-/
namespace WheelAnchorBlock

def Block (b lo hi size code : ℕ) : Prop :=
  ∃ S : Finset ℕ, S.card=size ∧
    (∀ k∈S, lo≤k ∧ k<hi ∧ (b+30030*k).Prime ∧ b+30030*k≤1076245223) ∧
    (∑ k∈S, 32768^(k-lo))=code

def offsets (width mask : ℕ) : Finset ℕ :=
  (Finset.range width).filter (fun i => mask.testBit i)

def anchor (b lo i : ℕ) := b+30030*(lo+i)

def factor (p : ℕ) := if p≤44000 then 1 else p

theorem prime_of_coprime {p L : ℕ} (h2 : 2≤p) (hu : p≤1076245223)
    (cover : ∀ q : ℕ, 2≤q → q≤44000 → q∣L) (hc : p.Coprime L) : p.Prime := by
  by_contra h
  have hsq := Nat.minFac_sq_le_self (by omega : 0<p) h
  have hq := Nat.minFac_prime (by omega : p≠1)
  have hbound : p.minFac≤44000 := by
    by_contra! hlt
    have := Nat.pow_le_pow_left (by omega : 44001≤p.minFac) 2
    norm_num at this
    omega
  exact hq.ne_one (Nat.eq_one_of_dvd_coprimes hc (Nat.minFac_dvd p) (cover _ hq.two_le hbound))

theorem leaf (b lo width mask size code L : ℕ)
    (cover : ∀ q : ℕ, 2≤q → q≤44000 → q∣L)
    (count : (offsets width mask).card=size)
    (digits : (∑ i∈offsets width mask, 32768^i)=code)
    (bounds : ∀ i∈offsets width mask, 2≤anchor b lo i ∧ anchor b lo i≤1076245223 ∧
      (anchor b lo i≤44000 → (anchor b lo i).Prime))
    (cop : (∏ i∈offsets width mask, factor (anchor b lo i)).Coprime L) :
    Block b lo (lo+width) size code := by
  let T := offsets width mask
  have inj : Function.Injective (fun i : ℕ => lo+i) := fun _ _ h => Nat.add_left_cancel h
  refine ⟨T.image (fun i => lo+i), (Finset.card_image_of_injective _ inj).trans count, ?_, ?_⟩
  · intro k hk
    obtain ⟨i,hi,rfl⟩ := Finset.mem_image.mp hk
    have hwidth := Finset.mem_range.mp (Finset.mem_filter.mp hi).1
    obtain ⟨h2,hu,hs⟩ := bounds i hi
    refine ⟨by omega,by omega,?_,hu⟩
    change (anchor b lo i).Prime
    by_cases hsmall : anchor b lo i≤44000
    · exact hs hsmall
    apply prime_of_coprime h2 hu cover
    have hd : factor (anchor b lo i) ∣ ∏ j∈T, factor (anchor b lo j) :=
      Finset.dvd_prod_of_mem _ hi
    exact Nat.Coprime.coprime_dvd_left (by simpa [factor,hsmall] using hd) cop
  · rw [Finset.sum_image (fun _ _ _ _ h => inj h)]
    simpa [T] using digits

theorem join {b lo mid hi n m c d : ℕ} (order : lo ≤ mid) (mh : mid ≤ hi)
    (left : Block b lo mid n c) (right : Block b mid hi m d) :
    Block b lo hi (n+m) (c+32768^(mid-lo)*d) := by
  obtain ⟨S,sc,sb,ss⟩ := left
  obtain ⟨T,tc,tb,ts⟩ := right
  have sep : Disjoint S T := Finset.disjoint_left.mpr fun i hs ht =>
    (not_lt_of_ge (tb i ht).1) (sb i hs).2.1
  refine ⟨S∪T, by rw [Finset.card_union_of_disjoint sep,sc,tc], ?_, ?_⟩
  · intro i h
    rcases Finset.mem_union.mp h with hs|ht
    · exact ⟨(sb i hs).1, lt_of_lt_of_le (sb i hs).2.1 mh, (sb i hs).2.2⟩
    · exact ⟨order.trans (tb i ht).1, (tb i ht).2⟩
  · rw [Finset.sum_union sep,ss,← ts,Finset.mul_sum]
    congr 1
    apply Finset.sum_congr rfl
    intro i hi'
    rw [← pow_add]
    have hmi := (tb i hi').1
    rw [show mid-lo+(i-mid) = i-lo by omega]

structure Totals where
  count : ℕ
  code : ℕ
  product : ℕ
  valid : Bool

private def small : List ℕ :=
  [17,19,23,181,29,37,41,43,31,47,53,67,30047,30211,30059,30071,30097]

private theorem small_prime (p : ℕ) (h : p ∈ small) : p.Prime := by
  simp only [small,List.mem_cons,List.not_mem_nil,or_false] at h
  rcases h with rfl|rfl|rfl|rfl|rfl|rfl|rfl|rfl|rfl|rfl|rfl|rfl|rfl|rfl|rfl|rfl|rfl <;> norm_num

def boundCheck (p : ℕ) : Bool :=
  decide (2 ≤ p ∧ p ≤ 1076245223) && (if p ≤ 44000 then small.contains p else true)

private theorem boundCheck_sound {p : ℕ} (h : boundCheck p=true) :
    2 ≤ p ∧ p ≤ 1076245223 ∧ (p ≤ 44000 → p.Prime) := by
  obtain ⟨hsize, hp⟩ := Bool.and_eq_true_iff.mp h
  obtain ⟨hlo,hhi⟩ := of_decide_eq_true hsize
  refine ⟨hlo,hhi,fun hsmall => small_prime p ?_⟩
  simpa [hsmall] using hp

def scan (b lo mask : ℕ) : ℕ → Totals
  | 0 => ⟨0,0,1,true⟩
  | i+1 =>
    let s := scan b lo mask i
    if mask.testBit i then
      let p := anchor b lo i
      ⟨s.count+1,s.code+32768^i,s.product*factor p,s.valid && boundCheck p⟩
    else s

private theorem scan_spec (b lo mask i : ℕ) :
    let s := scan b lo mask i
    let T := offsets i mask
    s.count=T.card ∧ s.code=(∑ j∈T, 32768^j) ∧
      s.product=(∏ j∈T, factor (anchor b lo j)) ∧
      (s.valid=true ↔ ∀ j∈T, boundCheck (anchor b lo j)=true) := by
  induction i with
  | zero => simp [scan,offsets]
  | succ i ih =>
    obtain ⟨hc,hd,hp,hv⟩ := ih
    have fresh : i ∉ offsets i mask := by simp [offsets]
    cases bit : mask.testBit i with
    | false =>
      have eq : offsets (i+1) mask = offsets i mask := by
        simp [offsets,Finset.range_add_one,Finset.filter_insert,bit]
      simpa only [scan,bit,Bool.false_eq_true,ite_false,eq] using And.intro hc ⟨hd,hp,hv⟩
    | true =>
      have eq : offsets (i+1) mask = insert i (offsets i mask) := by
        simp [offsets,Finset.range_add_one,Finset.filter_insert,bit]
      simp only [scan,bit,ite_true,eq,Finset.card_insert_of_notMem fresh,Finset.sum_insert fresh,
        Finset.prod_insert fresh,hc,hd,hp,Bool.and_eq_true_iff,hv,Finset.forall_mem_insert,
        and_comm,add_comm,mul_comm,true_and]

theorem checked_leaf (b lo width mask size code product inverse L : ℕ)
    (cover : ∀ q : ℕ, 2 ≤ q → q ≤ 44000 → q∣L)
    (count : (scan b lo mask width).count=size) (digits : (scan b lo mask width).code=code)
    (prod : (scan b lo mask width).product=product) (valid : (scan b lo mask width).valid=true)
    (unit : L*inverse ≡ 1 [MOD product]) :
    Block b lo (lo+width) size code := by
  obtain ⟨hc,hd,hp,hv⟩ := scan_spec b lo mask width
  exact leaf b lo width mask size code L cover (hc.symm.trans count) (hd.symm.trans digits)
    (fun i hi => boundCheck_sound (hv.mp valid i hi))
    (by rw [← hp,prod]; exact (Nat.coprime_of_mul_modEq_one inverse unit).symm)

theorem scanned_coprime (b lo mask width L : ℕ)
    (cover : ∀ q : ℕ, 2 ≤ q → q ≤ 44000 → q ∣ L)
    (valid : (scan b lo mask width).valid = true)
    (cop : (scan b lo mask width).product.gcd L = 1) :
    Block b lo (lo+width) (scan b lo mask width).count (scan b lo mask width).code := by
  obtain ⟨hc,hd,hp,hv⟩ := scan_spec b lo mask width
  exact leaf b lo width mask _ _ L cover hc.symm hd.symm
    (fun i hi => boundCheck_sound (hv.mp valid i hi)) (by rwa [← hp])

end WheelAnchorBlock

