/-!
Reduction modulo B^r-1 collects the coefficients of a polynomial evaluated
at B into congruence classes of exponents modulo r. When the total number
of terms is at most B-2, the base-B digits give the exact fiber sizes.
-/
namespace WheelCyclicHistogram

private theorem powCycle (B r k : ℕ) (hB : 0<B) :
    B^k ≡ B^(k % r) [MOD B^r-1] := by
  have h : B^r ≡ 1 [MOD B^r-1] := Nat.modEq_sub (Nat.one_le_pow r B hB)
  have hh : (B^r)^(k/r) ≡ 1 [MOD B^r-1] := by simpa using h.pow (k/r)
  calc
    B^k = B^(k % r)*(B^r)^(k/r) := by rw [← pow_mul, ← pow_add, Nat.mod_add_div]
    _ ≡ B^(k % r)*1 [MOD B^r-1] := (Nat.ModEq.refl _).mul hh
    _ = _ := Nat.mul_one _

private theorem folded {α : Type*} (A : Finset α) (f : α → ℕ) (B r : ℕ) (hB : 0<B) :
    (∑ i ∈ A, B^(f i)) ≡ (∑ i ∈ A, B^(f i % r)) [MOD B^r-1] := by
  classical
  induction A using Finset.induction_on with
  | empty => simp [Nat.ModEq]
  | @insert i S hs ih =>
    simp only [Finset.sum_insert hs]
    exact (powCycle B r (f i) hB).add ih

private theorem ceiling {α : Type*} (A : Finset α) (f : α → ℕ) (B k : ℕ) (hB : 0<B)
    (h : ∀ i ∈ A, f i ≤ k) : (∑ i ∈ A, B^(f i)) ≤ A.card*B^k := by
  calc
    _ ≤ ∑ _i ∈ A, B^k := Finset.sum_le_sum fun i hi => Nat.pow_le_pow_right hB (h i hi)
    _ = _ := by simp

private theorem digit_count {α : Type*} (A : Finset α) (f : α → ℕ) (B t : ℕ)
    (hc : A.card<B) :
    ((∑ i ∈ A, B^(f i)) / B^t) % B = (A.filter (fun i => f i=t)).card := by
  classical
  let low (i : α) := if f i<t then B^(f i) else 0
  let same (i : α) := if f i=t then 1 else 0
  let high (i : α) := if t<f i then B^(f i-(t+1)) else 0
  have hb : 0<B := by omega
  have hterm (i : α) : B^(f i)=low i+B^t*(same i+B*high i) := by
    rcases lt_trichotomy (f i) t with h|h|h
    · simp [low,same,high,h,h.ne,not_lt_of_ge h.le]
    · simp [low,same,high,h]
    · have hadd : t+1+(f i-(t+1)) = f i := by omega
      simp [low,same,high,h,not_lt_of_ge h.le,h.ne',← mul_assoc,← pow_succ,← pow_add,hadd]
  have hsum : (∑ i ∈ A, B^(f i)) =
      (∑ i ∈ A, low i)+B^t*((∑ i ∈ A, same i)+B*(∑ i ∈ A, high i)) := by
    calc
      _ = ∑ i ∈ A, (low i+B^t*(same i+B*high i)) := Finset.sum_congr rfl (fun i _ => hterm i)
      _ = _ := by simp only [Finset.sum_add_distrib,← Finset.mul_sum]
  have heq : (∑ i ∈ A, same i) = (A.filter (fun i => f i=t)).card := by
    simp [same]
  have hl : (∑ i ∈ A, low i)<B^t := by
    cases t with
    | zero => simp [low]
    | succ u =>
      have hcard : (A.filter (fun i => f i<u+1)).card<B := lt_of_le_of_lt (Finset.card_filter_le ..) hc
      calc
        _ = ∑ i ∈ A.filter (fun i => f i<u+1), B^(f i) := (Finset.sum_filter ..).symm
        _ ≤ _ := ceiling _ f B u hb (fun i hi => Nat.le_of_lt_succ (Finset.mem_filter.mp hi).2)
        _ < B*B^u := Nat.mul_lt_mul_of_pos_right hcard (pow_pos hb _)
        _ = _ := (pow_succ' B u).symm
  have hcard : (A.filter (fun i => f i=t)).card < B := lt_of_le_of_lt (Finset.card_filter_le ..) hc
  rw [hsum,Nat.add_mul_div_left _ _ (pow_pos hb _),Nat.div_eq_of_lt hl,Nat.zero_add,
    Nat.add_mul_mod_self_left,heq,Nat.mod_eq_of_lt hcard]

theorem fiber_digits {α : Type*} (A : Finset α) (f : α → ℕ) (B r t : ℕ)
    (hc : A.card+1<B) (hr : 0<r) :
    (((∑ i ∈ A, B^(f i)) % (B^r-1)) / B^t) % B =
      (A.filter (fun i => f i % r=t)).card := by
  have hb : 0<B := by omega
  have hlt : (∑ i ∈ A, B^(f i % r)) < B^r-1 := by
    obtain ⟨k,rfl⟩ := Nat.exists_eq_succ_of_ne_zero (Nat.ne_of_gt hr)
    have hh := ceiling A (fun i => f i % (k+1)) B k hb (fun i _ => Nat.le_of_lt_succ (Nat.mod_lt _ (by omega)))
    have hstrict := Nat.mul_lt_mul_of_pos_right hc (pow_pos hb k)
    have hp : 0<B^k := pow_pos hb _
    rw [Nat.add_mul,Nat.one_mul] at hstrict
    rw [pow_succ']
    simp only [Nat.succ_eq_add_one] at *
    omega
  have he := folded A f B r hb
  change _ % _ = _ % _ at he
  rw [he,Nat.mod_eq_of_lt hlt]
  exact digit_count A (fun i => f i % r) B t (by omega)
end WheelCyclicHistogram

theorem Conjectures.Goldbach.WheelCyclicHistogram :
    ∀ (A : Finset ℕ) (B r t : ℕ), A.card+1<B → 0<r →
      (((∑ k ∈ A, B^k) % (B^r-1)) / B^t) % B =
        (A.filter (fun k => k % r=t)).card :=
  fun A B r t => WheelCyclicHistogram.fiber_digits A id B r t

/-!
The wheel uses a class modulo W to handle the first prime divisors. An
additional prime r excludes at most one residue class modulo r, even when
many anchors have the same residue. We bound the size of each excluded
fiber and retain an explicit lower bound for the number of surviving anchors.
The coprimality transfer follows the accepted injective-wheel lemma at
ddbd820f92eed8b56debc9ced359f579c817374c.
-/

namespace FiniteWheelMultiplicity

theorem surviving_residues (P S : Finset ℕ) (loss : ℕ → ℕ) (n : ℕ)
    (hpos : ∀ r ∈ P, 0 < r)
    (hcap : ∀ r ∈ P, ∀ t < r, (S.filter (fun p => p % r=t)).card ≤ loss r) :
    S.card - ∑ r ∈ P, loss r ≤
      (S.filter (fun p => ∀ r ∈ P, p % r ≠ n % r)).card := by
  classical
  let bad (r : ℕ) := S.filter (fun p => p % r=n % r)
  let U := P.biUnion bad
  have hb : U.card ≤ ∑ r ∈ P, loss r :=
    Finset.card_biUnion_le.trans (Finset.sum_le_sum fun r hr =>
      hcap r hr (n % r) (Nat.mod_lt _ (hpos r hr)))
  have hs : S \ U = S.filter (fun p => ∀ r ∈ P, p % r ≠ n % r) := by
    ext p
    by_cases hp : p ∈ S <;> simp [bad,U,hp]
  have hsum : S.card ≤ (S \ U).card + U.card := Finset.card_le_card_sdiff_add_card
  rw [hs] at hsum
  omega

theorem coprime_count (P S : Finset ℕ) (b W B n : ℕ) (loss : ℕ → ℕ)
    (hb : b < W) (hn : B+2 ≤ n) (hbase : ((n+W-b) % W).Coprime W)
    (hanchors : ∀ p ∈ S, Nat.Prime p ∧ p≤B ∧ p % W=b)
    (hprimes : ∀ r ∈ P, Nat.Prime r)
    (hcap : ∀ r ∈ P, ∀ t < r, (S.filter (fun p => p % r=t)).card ≤ loss r) :
    S.card - ∑ r ∈ P, loss r ≤
      (S.filter (fun p => p.Prime ∧ p≤B ∧ 2≤n-p ∧ (n-p).Coprime (W*∏ r ∈ P, r))).card := by
  apply (surviving_residues P S loss n (fun r hr => (hprimes r hr).pos) hcap).trans
  apply Finset.card_le_card
  intro p hp
  obtain ⟨hpS, hok⟩ := Finset.mem_filter.mp hp
  obtain ⟨hprime,hbound,hres⟩ := hanchors p hpS
  have hpN : p ≤ n := by omega
  refine Finset.mem_filter.mpr ⟨hpS,hprime,hbound,by omega,Nat.Coprime.mul_right ?_ ?_⟩
  · have h1 : n ≡ n+W [MOD W] := by simp [Nat.ModEq]
    have h2 : p ≡ b [MOD W] := by simp [Nat.ModEq,Nat.mod_eq_of_lt hb,hres]
    have hsub := h1.sub hpN (by omega : b≤n+W) h2
    unfold Nat.ModEq at hsub
    unfold Nat.Coprime at hbase ⊢
    rw [Nat.gcd_comm (n-p) W, Nat.gcd_rec, hsub, Nat.gcd_comm]
    simpa [Nat.gcd_comm] using hbase
  · apply Nat.Coprime.prod_right
    intro r hr
    apply Nat.Coprime.symm
    apply (hprimes r hr).coprime_iff_not_dvd.mpr
    intro hd
    have hm := (Nat.modEq_zero_iff_dvd.mpr hd).add (Nat.ModEq.refl p)
    exact hok r hr (by simpa [Nat.ModEq,Nat.sub_add_cancel hpN] using hm.symm)

end FiniteWheelMultiplicity

theorem Conjectures.Goldbach.FiniteWheelResidueMultiplicity :
    ∀ (P S : Finset ℕ) (b W B n : ℕ) (loss : ℕ → ℕ),
      b<W → B+2≤n → Nat.Coprime ((n+W-b) % W) W →
      (∀ p ∈ S, Nat.Prime p ∧ p≤B ∧ p % W=b) →
      (∀ r ∈ P, Nat.Prime r) →
      (∀ r ∈ P, ∀ t < r, (S.filter (fun p => p % r=t)).card ≤ loss r) →
      S.card - ∑ r ∈ P, loss r ≤
        (S.filter (fun p => Nat.Prime p ∧ p≤B ∧ 2≤n-p ∧ Nat.Coprime (n-p) (W*∏ r ∈ P, r))).card :=
  FiniteWheelMultiplicity.coprime_count

