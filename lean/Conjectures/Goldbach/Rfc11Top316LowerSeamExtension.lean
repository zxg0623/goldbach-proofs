private theorem old_misses (i : ℕ) (hi : i ∈ obstructions) (a : ℕ)
    (ha : a ∈ CutpointLowerCert.originals) : ¬ (a-2*i).Prime := by
  have check : obstructions.all (fun j => CutpointLowerCert.originals.all
    (fun t => ruledOut (t-2*j))) = true := by decide +kernel
  have h := (List.all_eq_true.mp ((List.all_eq_true.mp check) i hi)) a ha
  exact ruledOut_sound _ h

/-- No one additional prime anchor, of any size, can repair the original bank. -/
theorem no_single_repair (t : ℕ) (large : Nat.Prime (10^316-t)) :
    ¬ ∀ i ∈ obstructions, ∃ a ∈ CutpointLowerCert.originals ++ [t], (a-2*i).Prime := by
  intro complete
  have hit (i : ℕ) (hi : i ∈ obstructions) : (t-2*i).Prime := by
    obtain ⟨a,ha,prime⟩ := complete i hi
    rcases List.mem_append.mp ha with prior | fresh
    · exact False.elim (old_misses i hi a prior prime)
    · simp only [List.mem_singleton] at fresh
      simpa [fresh] using prime
  have a := hit 13677 (by decide)
  have b := hit 14442 (by decide)
  have c := hit 13996 (by decide)
  have d := hit 15751 (by decide)
  change (t-27354).Prime at a
  change (t-28884).Prime at b
  change (t-27992).Prime at c
  change (t-31502).Prime at d
  change (-t).Prime at large
  have eq3 {x : ℕ} (prime : x.Prime) (div : 3 ∣ x) : x=3 :=
    ((Nat.prime_dvd_prime_iff_eq (by decide) prime).mp div).symm
  have cases : t % 3 = 0 ∨ t % 3 = 1 ∨ t % 3 = 2 := by omega
  rcases cases with hz | ho | ht
  · have eq₁ := eq3 a (by omega)
    have eq₂ := eq3 b (by omega)
    omega
  · have eq := eq3 large (by omega)
    have df : 5 ∣ t-27992 := by omega
    have five := (Nat.prime_dvd_prime_iff_eq (by decide) c).mp df
    omega
  · have eq₁ := eq3 c (by omega)
    have eq₂ := eq3 d (by omega)
    omega

end CutpointLowerSeam

theorem Conjectures.Goldbach.Rfc11Top316LowerSeamExtension : (fun (lo hi : ℕ) => ∀ n : ℕ, lo≤n → n<hi → 2∣n → ∃ p q : ℕ, p.Prime ∧ q.Prime ∧ p+q=n) (10^316-32768) (10^316-24576) := CutpointLowerSeam.result
