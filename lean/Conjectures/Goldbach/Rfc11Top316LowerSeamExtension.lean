theorem result : (fun (lo hi : ℕ) => ∀ n : ℕ, lo≤n → n<hi → 2∣n → ∃ p q : ℕ, p.Prime ∧ q.Prime ∧ p+q=n) (10^316-32768) (10^316-24576) := by
  intro n hlo hhi he
  obtain ⟨m,hm⟩ := he
  change  ≤ n at hlo
  change n <  at hhi
  let d :=  - m
  have hd : d < 4096 := by dsimp [d]; omega
  have hn : n + 2*(12289+d) =  := by dsimp [d]; omega
  let b : Fin 32 := ⟨d/128,by omega⟩
  have check := (List.all_eq_true.mp (verified b)) (d % 128) (List.mem_range.mpr (Nat.mod_lt _ (by decide)))
  change hit (128*(d/128)+d % 128) = true at check
  rw [show 128*(d/128)+d % 128=d by omega] at check
  obtain ⟨ltTag,prime⟩ := Bool.and_eq_true_iff.mp check
  have ix := of_decide_eq_true ltTag
  have hp := primeTest_sound _ prime
  let a := anchors.getD (tag d) 0
  have mem : a ∈ anchors := by
    dsimp [a]
    rw [List.getD_eq_getElem _ _ ix]
    exact List.getElem_mem _
  have cap : anchors.all (fun a => decide (a ≤ 950943941)) = true := by decide +kernel
  have bound := of_decide_eq_true ((List.all_eq_true.mp cap) a mem)
  change (a-2*(12289+d)).Prime at hp
  have pos := hp.two_le
  refine ⟨10^316-a,a-2*(12289+d),CutpointLowerCert.primes a mem,hp,?_⟩
  change -a+(a-2*(12289+d))=n
  omega
