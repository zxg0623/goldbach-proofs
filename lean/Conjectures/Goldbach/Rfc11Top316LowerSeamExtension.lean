private def factorial300 : ℕ := 
private theorem factorial_checked : factorial300=Nat.factorial 300 := by decide +kernel
private def primeTest (q : ℕ) : Bool := if q ≤ 300 then decide q.Prime else
  if q < 90000 then decide (q.Coprime factorial300) else decide (q ∈ largeSmall.map Subtype.val)
private theorem primeTest_sound (q : ℕ) (h : primeTest q = true) : q.Prime := by
  by_cases hs : q ≤ 300
  · simpa [primeTest,hs] using h
  by_cases hm : q < 90000
  · have cop : q.Coprime (Nat.factorial 300) := by simpa [primeTest,hs,hm,factorial_checked] using h
    by_contra hn
    have low := (Nat.minFac_prime (by omega : q≠1)).two_le
    have sq := Nat.minFac_sq_le_self (by omega : 0<q) hn
    have bound : q.minFac ≤ 300 := by
      by_contra! bad
      have product := Nat.mul_le_mul bad bad
      rw [pow_two] at sq
      omega
    have both := Nat.dvd_gcd (Nat.minFac_dvd q) (Nat.dvd_factorial (by omega) bound)
    rw [cop.gcd_eq_one] at both
    have eq := Nat.dvd_one.mp both
    omega
  · have mem : q ∈ largeSmall.map Subtype.val := by simpa [primeTest,hs,hm] using h
    obtain ⟨p,_,rfl⟩ := List.mem_map.mp mem
    exact p.property
